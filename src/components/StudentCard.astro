---
const { nombre, carrera, semestre } = Astro.props;
---
<article class="card">
  <h2>👨‍🎓 {nombre}</h2>
  <p><strong>Carrera:</strong> {carrera}</p>
  <p><strong>Semestre:</strong> {semestre}</p>
</article>

<style>
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h2 {
    font-size: 1.25rem;
    color: #1e293b;
    margin-bottom: 0.25rem;
  }
  p {
    color: #475569;
    font-size: 0.95rem;
  }
</style>