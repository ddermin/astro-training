---
const { sistema, descripcion, slug } = Astro.props;
---
<article class="software-card">
  <h3>💻 Sistema: {sistema}</h3>
  <p>{descripcion}</p>
  {slug && <a href={`/software/${slug}`} class="link">Ver detalles →</a>}
</article>

<style>
  .software-card {
    background-color: #f0f7ff;
    border: 1px solid #bae6fd;
    padding: 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h3 {
    color: #0369a1;
    font-size: 1.2rem;
  }
  p {
    color: #334155;
    font-size: 0.95rem;
  }
  .link {
    margin-top: 0.5rem;
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .link:hover {
    text-decoration: underline;
  }
</style>