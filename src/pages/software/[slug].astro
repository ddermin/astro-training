---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const systems = [
    {
      slug: "ner-dd",
      sistema: "NER-DD",
      imagen: "https://placehold.co/800x350/0284c7/ffffff?text=NER-DD",
      descripcion: "Plataforma de extracción y análisis de datos documentales mediante reconocimiento de entidades.",
      sitioWeb: "https://lasaid.example.org/ner-dd",
      repositorio: "https://github.com/ddermin/astro-training",
      publicacion: "IEEE Access (2025) - Named Entity Recognition for Data Discovery"
    },
    {
      slug: "ggg",
      sistema: "GGG",
      imagen: "https://placehold.co/800x350/0f172a/ffffff?text=Sistema+GGG",
      descripcion: "Gestor general de recursos, flujos de trabajo y monitoreo de procesos académicos.",
      sitioWeb: "https://lasaid.example.org/ggg",
      repositorio: "https://github.com/ddermin/astro-training",
      publicacion: "Journal of Systems & Software (2025) - GGG Architecture"
    },
    {
      slug: "signapros",
      sistema: "SignAPROS",
      imagen: "https://placehold.co/800x350/0369a1/ffffff?text=SignAPROS",
      descripcion: "Sistema avanzado para el procesamiento, filtrado y visualización de señales digitales.",
      sitioWeb: "https://lasaid.example.org/signapros",
      repositorio: "https://github.com/ddermin/astro-training",
      publicacion: "Signal Processing Letters (2026) - SignAPROS Framework"
    }
  ];

  return systems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<BaseLayout pageTitle={`Sistema ${item.sistema}`}>
  <a href="/software" class="back-link">← Volver a Sistemas</a>

  <article class="software-detail">
    <img src={item.imagen} alt={item.sistema} class="banner-img" />
    <h1>💻 Sistema: {item.sistema}</h1>
    <p class="subtitle">{item.descripcion}</p>
    <hr />
    <p><strong>🌐 Sitio web oficial:</strong> <a href={item.sitioWeb} target="_blank">{item.sitioWeb}</a></p>
    <p><strong>📦 Repositorio:</strong> <a href={item.repositorio} target="_blank">{item.repositorio}</a></p>
    <p><strong>📄 Publicación asociada:</strong> {item.publicacion}</p>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
  }
  .software-detail {
    background-color: #ffffff;
    border: 1px solid #bae6fd;
    padding: 2rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .banner-img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    font-size: 1.1rem;
    color: #334155;
  }
  hr {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 0.5rem 0;
  }
  a {
    color: #0284c7;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>