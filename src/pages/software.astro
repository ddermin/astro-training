---
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
const titulo = "Software";
---

<BaseLayout pageTitle={titulo}>
  <h1>Sistemas Desarrollados</h1>
  <div class="grid-container">
    <SoftwareCard sistema="NER-DD" descripcion="Plataforma de extracción y análisis de datos." />
    <SoftwareCard sistema="GGG" descripcion="Gestor general de recursos y procesos." />
    <SoftwareCard sistema="SignAPROS" descripcion="Sistema de procesamiento de señales avanzado." />
  </div>
</BaseLayout>