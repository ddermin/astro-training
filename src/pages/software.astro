---
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';

const titulo = "Software";

const systems = [
  {
    slug: "ner-dd",
    sistema: "NER-DD",
    descripcion: "Plataforma de extracción y análisis de datos."
  },
  {
    slug: "ggg",
    sistema: "GGG",
    descripcion: "Gestor general de recursos y procesos."
  },
  {
    slug: "signapros",
    sistema: "SignAPROS",
    descripcion: "Sistema de procesamiento de señales avanzado."
  }
];
---

<BaseLayout pageTitle={titulo}>
  <h1>Sistemas Desarrollados</h1>
  <div class="grid-container">
    {
      systems.map((item) => (
        <SoftwareCard 
          sistema={item.sistema} 
          descripcion={item.descripcion} 
          slug={item.slug}
        />
      ))
    }
  </div>
</BaseLayout>